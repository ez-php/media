{
  "name": "ez-php/media",
  "version": "2.5.0",
  "description": "Image resizing and file processing: transformations over a StorageInterface source via ext-gd or ext-imagick",
  "type": "library",
  "license": "MIT",
  "authors": [
    {
      "name": "Andreas Uretschnig",
      "email": "andreas.uretschnig@gmail.com"
    }
  ],
  "keywords": ["media", "image", "resize", "crop", "gd", "imagick", "php", "ez-php"],
  "homepage": "https://github.com/ez-php/media",
  "support": {
    "issues": "https://github.com/ez-php/media/issues",
    "source": "https://github.com/ez-php/media"
  },
  "require": {
    "php": "^8.5",
    "ext-gd": "*",
    "ez-php/contracts": "^2.0",
    "ez-php/storage": "^2.0"
  },
  "suggest": {
    "ext-imagick": "Required to use ImagickDriver instead of the default GdDriver"
  },
  "require-dev": {
    "ez-php/docker": "^2.0",
    "phpunit/phpunit": "^13.0",
    "phpstan/phpstan": "^2.1",
    "friendsofphp/php-cs-fixer": "^3.94",
    "phpstan/phpstan-strict-rules": "^2.0",
    "phpstan/phpstan-deprecation-rules": "^2.0"
  },
  "autoload": {
    "psr-4": {
      "EzPhp\\Media\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },
  "scripts": {
    "cs": "php-cs-fixer fix",
    "analyse": "phpstan analyse",
    "test": "phpunit",
    "full": "composer analyse && composer cs && composer test"
  }
}
